<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0, matching Nafas.Observability itself; no
         FrameworkReference, no Kestrel, no OWIN. The transport here is a
         hand-rolled HTTP/1.1 server directly on System.Net.Sockets.TcpListener
         (see Internal/NafasRawHttpConnection.cs's own comment for why: neither
         Kestrel nor OWIN are acceptable dependencies for this package, and
         System.Net.HttpListener (the BCL's own listener) turned out not
         to be a workable alternative either: on Windows it's backed by
         HTTP.sys, which refuses to bind any prefix other than "localhost"
         (verified empirically: a non-admin process gets "Access is denied"
         binding "+", "*", or even one specific LAN IP, unless the process
         runs elevated or a URL ACL was reserved beforehand via
         `netsh http add urlacl`); exactly the LAN-access scenario this
         package exists for. A raw TcpListener has no such restriction
         (verified the same way: loopback, wildcard, and a specific LAN IP
         all bind fine as a normal user) and works identically on .NET
         Framework 4.6.1+, not just modern .NET, so this package needs only
         one TargetFramework, same as the core package. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    NuGet package metadata; mirrors Nafas.Observability.csproj's own
    conventions (see that file's comment for the full reasoning).
  -->
  <PropertyGroup>
    <PackageId>Nafas.Observability.Server</PackageId>
    <Version>0.1.0</Version>
    <Authors>Aban-Inc</Authors>
    <Company>Aban-Inc</Company>
    <Description>Optional standalone HTTP listener for Nafas.Observability -- for apps with no ASP.NET Core pipeline of their own (WinForms, WPF, console services) to still serve the Nafas dashboard, on its own configurable port. No Kestrel, no OWIN -- a minimal HTTP/1.1 server directly on TcpListener.</Description>
    <PackageTags>observability;logging;metrics;tracing;monitoring;dashboard;desktop;winforms;wpf</PackageTags>
    <PackageProjectUrl>https://github.com/Aban-Inc/nafas.observability.package</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Aban-Inc/nafas.observability.package.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>0.1.0: Initial release. A standalone HTTP/1.1 listener (raw System.Net.Sockets.TcpListener, no Kestrel, no OWIN) so WinForms/WPF/console apps with no ASP.NET Core pipeline of their own can still serve the Nafas dashboard, on its own configurable port, with a LocalhostOnly/Lan access-mode switch. Requires Nafas.Observability 0.1.2+.</PackageReleaseNotes>
    <Title>Nafas Observability -- Server</Title>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\Nafas.Observability\LICENSE.md" Pack="true" PackagePath="" />
    <!-- Same root README.md as Nafas.Observability itself (also what GitHub
         shows); it already documents this package in its own "Desktop and
         other non-ASP.NET Core apps" section, so there's one doc to keep in
         sync, not two. -->
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\Nafas.Observability\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nafas.Observability\Nafas.Observability.csproj" />
  </ItemGroup>

  <!--
    Microsoft.AspNetCore.Http gives us DefaultHttpContext (a concrete,
    constructible HttpContext we build ourselves per request; nothing here
    is supplied by a hosting layer, unlike the embedded-dashboard path) and
    Microsoft.AspNetCore.Builder.Internal.ApplicationBuilder (the concrete
    IApplicationBuilder UseNafasDashboard needs to mount onto). This is NOT
    Kestrel or a hosting package; it's the server-agnostic HTTP abstraction
    model, the same reason ASP.NET Core itself can swap Kestrel/IIS/HttpSys
    without touching middleware code. Confirmed empirically on netstandard2.0
    (both types construct and run a real middleware pipeline) before relying
    on it here. 2.3.13 is the actively-republished (security-patched)
    netstandard2.0-targeting line of this package, same story as
    Microsoft.AspNetCore.Http.Abstractions 2.2.0 already used by
    Nafas.Observability itself.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.13" />
    <!-- Microsoft.AspNetCore.Http 2.3.13 itself references an old (1.1.1)
         Microsoft.Bcl.AsyncInterfaces; fine when this package is
         consumed inside an ASP.NET Core app (which already carries a modern
         one via the shared framework), but a bare net8.0 console/WPF/
         WinForms app (this package's whole reason to exist) has nothing
         else pulling a newer one in, and hits a FileNotFoundException at
         run time when something needs 8.0.0's surface. Pinned here so
         every consumer gets a consistent, working version without needing
         to know about or work around this themselves. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
